        <mxCell id="day0" value="Day0 — подготовка региона" style="swimlane;whiteSpace=wrap;html=1;container=1;recursiveResize=0;startSize=42;collapsible=0;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1.3;fontSize=18;fontStyle=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="110" width="825" height="730" />
        </mxCell>
        <mxCell id="day1" value="Day1 — первичный deployment" style="swimlane;whiteSpace=wrap;html=1;container=1;recursiveResize=0;startSize=42;collapsible=0;fillColor=#edf7ed;strokeColor=#82b366;strokeWidth=1.3;fontSize=18;fontStyle=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="885" y="110" width="570" height="730" />
        </mxCell>
        <mxCell id="day2" value="Day2 — эксплуатация" style="swimlane;whiteSpace=wrap;html=1;container=1;recursiveResize=0;startSize=42;collapsible=0;fillColor=#eaf2f8;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=18;fontStyle=1;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="110" width="630" height="730" />
        </mxCell>
        <mxCell id="title3" value="&lt;b&gt;LCM (PVS) — сквозной жизненный цикл OpenStack региона&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#1f1f1f;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="2080" height="46" />
        </mxCell>
        <mxCell id="subtitle3" value="PVS управляет конфигурацией и исполнением; фактический deployment выполняет kolla-ansible на узлах региона" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#1f1f1f;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="62" width="2080" height="26" />
        </mxCell>
        <mxCell id="d0_s1" value="&lt;b&gt;1. Регистрация региона&lt;/b&gt;&lt;br&gt;Operator → backend → openstack-hub&lt;br&gt;pvs_regions + hub_managed_regions" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="45" y="65" width="330" height="100" />
        </mxCell>
        <mxCell id="d0_s2" value="&lt;b&gt;2. Инвентарь / сеть&lt;/b&gt;&lt;br&gt;NBox: site • devices • VLAN / IPAM&lt;br&gt;readiness / optional provisioning" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="430" y="65" width="330" height="100" />
        </mxCell>
        <mxCell id="d0_s3" value="&lt;b&gt;3. Релиз Kolla-Ansible&lt;/b&gt;&lt;br&gt;import from Git / rescan&lt;br&gt;release + capabilities + parameters" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="45" y="215" width="330" height="110" />
        </mxCell>
        <mxCell id="d0_s4" value="&lt;b&gt;4. Config profile / preset&lt;/b&gt;&lt;br&gt;profile + overrides + site variables&lt;br&gt;effective config preview" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="430" y="215" width="330" height="110" />
        </mxCell>
        <mxCell id="d0_s5" value="&lt;b&gt;5. Runtime snapshot in per-region Git repository&lt;/b&gt;&lt;br&gt;hosts.yml • globals.yml • region.json • effective_config.json&lt;br&gt;The Git commit SHA becomes the deployment source of truth" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="45" y="385" width="715" height="120" />
        </mxCell>
        <mxCell id="d0_note" value="Optional bare-metal path: NBox / Hub → BMC / DHCP / PXE / Bifrost → OS-ready hosts.&lt;br&gt;Before deployment PVS performs inventory, release, registry, credentials and configuration gates." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#1f1f1f;rounded=1;fillColor=#ffffff;strokeColor=#d79b00;spacing=10;" vertex="1" parent="day0">
          <mxGeometry as="geometry" x="45" y="555" width="715" height="105" />
        </mxCell>
        <mxCell id="d1_s1" value="&lt;b&gt;6. Start deployment&lt;/b&gt;&lt;br&gt;openstack-hub creates RegionOperation&lt;br&gt;readiness gate + etcd region lock" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day1">
          <mxGeometry as="geometry" x="45" y="65" width="480" height="100" />
        </mxCell>
        <mxCell id="d1_s2" value="&lt;b&gt;7. Dispatch&lt;/b&gt;&lt;br&gt;DeployService → scheduler / ansible-orch&lt;br&gt;task payload + deadlines + retries" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day1">
          <mxGeometry as="geometry" x="45" y="215" width="480" height="100" />
        </mxCell>
        <mxCell id="d1_s3" value="&lt;b&gt;8. Execute on region&lt;/b&gt;&lt;br&gt;worker-agent runs kolla-ansible&lt;br&gt;prechecks → pull → deploy → post-deploy" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day1">
          <mxGeometry as="geometry" x="45" y="365" width="480" height="110" />
        </mxCell>
        <mxCell id="d1_s4" value="&lt;b&gt;9. Callback / status&lt;/b&gt;&lt;br&gt;worker-agent → openstack-hub&lt;br&gt;operation state • evidence • transcript" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day1">
          <mxGeometry as="geometry" x="45" y="530" width="480" height="100" />
        </mxCell>
        <mxCell id="d2_s1" value="&lt;b&gt;10. Lifecycle operations&lt;/b&gt;&lt;br&gt;upgrade • reconfigure • add/remove/replace node&lt;br&gt;scale-down • stop/start • rollback • destroy" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day2">
          <mxGeometry as="geometry" x="45" y="65" width="540" height="120" />
        </mxCell>
        <mxCell id="d2_s2" value="&lt;b&gt;11. Режим доступа к региону&lt;/b&gt;&lt;br&gt;pvs-openstack-agent (agent mode)&lt;br&gt;Direct SDK — архитектурная опция; live readiness не подтверждена" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day2">
          <mxGeometry as="geometry" x="45" y="235" width="540" height="100" />
        </mxCell>
        <mxCell id="d2_s3" value="&lt;b&gt;12. Scheduled maintenance&lt;/b&gt;&lt;br&gt;scheduler cron / interval / Day3 jobs&lt;br&gt;watchdog • DLQ • retry policy" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day2">
          <mxGeometry as="geometry" x="45" y="385" width="540" height="100" />
        </mxCell>
        <mxCell id="d2_s4" value="&lt;b&gt;13. Observability and audit&lt;/b&gt;&lt;br&gt;logs / audit → fluent-bit → OpenSearch&lt;br&gt;metrics → Prometheus / Grafana" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="day2">
          <mxGeometry as="geometry" x="45" y="535" width="540" height="105" />
        </mxCell>
        <mxCell id="bottom_note3" value="Граница ответственности: PVS — lifecycle control plane; tenant-facing Nova/Neutron/Cinder API остаются частью управляемого OpenStack-региона.&lt;br&gt;Конфигурация deployment версионируется в Git; секреты остаются в Vault и не коммитятся в репозиторий." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#1f1f1f;rounded=1;fillColor=#ffffff;strokeColor=#666666;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="870" width="2075" height="80" />
        </mxCell>
