        </mxCell>
        <mxCell id="svc_lb2" value="&lt;b&gt;Service pvs-haproxy&lt;/b&gt;&lt;br&gt;LoadBalancer • 80/443 → Deployment ×2&lt;br&gt;&lt;b&gt;container:&lt;/b&gt; HAProxy :8080/:8443" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.2;fontColor=#1f1f1f;fontFamily=Courier New;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="entry2">
